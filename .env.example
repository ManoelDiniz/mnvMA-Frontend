# Tudo com prefixo VITE_ vai para o bundle e é PÚBLICO.
# Nunca coloque segredo aqui — o ACCESS_TOKEN do Mercado Pago fica no backend.

VITE_API_URL=http://localhost:3000/v1
VITE_APP_NAME="MNVMA Care"

# Só a PUBLIC KEY do Mercado Pago (usada para tokenizar cartão no Brick).
VITE_MP_PUBLIC_KEY=

# Chave pública do Web Push (Sprint 9)
VITE_VAPID_PUBLIC_KEY=

VITE_SENTRY_DSN=
